# Apexure Shell — copy to .env.local (dev) / set on the Vercel project (prod).

# Google OAuth — SAME credentials as the Dashboard, so staff sign in once with
# the Google account they already use. Add the shell's callback URL to this
# OAuth client in Google Cloud console:
#   https://<shell-domain>/api/auth/callback/google   (+ http://localhost:3000/... for dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# NextAuth — a long random string; the canonical URL of THIS app.
NEXTAUTH_SECRET=""          # openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"   # prod: https://<shell-domain>

# Handoff signing — MUST be the exact same value as the Dashboard and LinkSpy
# SPINE_SECRET (the shell signs tokens those apps verify).
SPINE_SECRET=""

# The two live doors (no trailing slash).
DASHBOARD_URL="https://dashboard-nine-pi-19.vercel.app"
LINKSPY_URL="https://brokenlinkchecker-olive.vercel.app"

# BOARD_URL — add later when the Board door goes live (see README).
