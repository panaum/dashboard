// Deliverables Dashboard — data model
// Dev DB: SQLite (zero external setup). Enum-typed fields are stored as String
// because SQLite has no native enums; the allowed values live in
// src/lib/constants.ts. For production, switch the datasource to postgresql and
// promote the String fields to real Prisma enums.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id        String    @id @default(cuid())
  name      String    @unique
  notes     String?
  portalId  String?   @unique //                 opt-in public client portal token
  // Seam 1 (Phase 1): annotation onto the LinkSpy registry. Nullable; unset =
  // exactly today's behaviour. Never mutates any existing QA field.
  registryClientId String?
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  name      String
  type      String   @default("WEBSITE") // ProjectType
  platform  String   @default("OTHER") //   Platform
  url       String?
  status    String   @default("IN_PROGRESS") // Status
  pages     Page[]
  // Boards. A board is this project's issues that carry a boardStage, and the
  // developer-facing view is reached by a capability link — the same
  // mechanism as Page.shareId (random token on the row, null to revoke,
  // minted behind a permission), scoped to this project. Nullable; unset =
  // no developer link exists.
  boardShareId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model Page {
  id            String         @id @default(cuid())
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  name          String
  url           String?
  status        String         @default("IN_PROGRESS") // Status
  shareId       String?        @unique //                 public certificate link token (opt-in)
  livingCertificateEnabled Boolean @default(false) //     opt-in: certificate keeps reflecting live status
  developer     TeamMember?    @relation("Dev", fields: [developerId], references: [id], onDelete: SetNull)
  developerId   String?
  tester        TeamMember?    @relation("Tester", fields: [testerId], references: [id], onDelete: SetNull)
  testerId      String?
  delayDays     Int            @default(0)
  deliveryMonth String? //                              "2026-01" — powers monthly report
  // Seam 1 (Phase 1): registry annotation. Nullable; unset = today's behaviour.
  registryDeliverableId String? //                      the LinkSpy deliverable id
  registrySiteId        String? //                      the LinkSpy site id
  issues        Issue[]
  certificate   QACertificate?
  linkspyStatus LinkSpyStatus?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([projectId])
  @@index([deliveryMonth])
}

// "Still True Today" — cache + durable last-known-good for a page's live
// verification status pulled from LinkSpy. Read-only mirror; internal-only
// (never selected by the public certificate / client-portal views).
model LinkSpyStatus {
  id        String   @id @default(cuid())
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String   @unique
  payload   Json //     the raw /api/qa-bridge/status response
  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Issue {
  id          String   @id @default(cuid())
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId      String
  title       String
  description String?
  severity    String   @default("LOW") // Severity
  status      String   @default("OPEN") // IssueStatus
  // ── Boards (all nullable or defaulted: an issue that predates boards is
  //    untouched, and boardStage null means "not on a board").
  boardStage  String? //                                 BoardStage
  // QA arranges cards top-to-bottom within a stage; the developer works
  // top-down. Order IS the priority signal the developer view receives, so it
  // has to persist — the spec implies it and names no field.
  boardOrder  Int      @default(0)
  // Where on the site the issue is — a URL to the page or feature.
  link        String?
  // Separate from severity on purpose. A low-severity recurring bug is a
  // different problem from a one-off high-severity one. (The existing
  // REPETITIVE severity value already conflates the two; it is left alone.)
  recurring   Boolean  @default(false)
  assignee    TeamMember? @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId  String?
  // The QA who logged it. Null on today's single shared session — there is
  // no per-person identity to record until access control lands.
  reporter    TeamMember? @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reporterId  String?
  events      IssueEvent[]
  comments    IssueComment[]
  images      IssueImage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pageId])
  @@index([assigneeId])
  @@index([boardStage])
}

// One row per stage change — the current stage alone cannot yield cycle time
// or bounce-backs, so this is the source every board metric is computed from.
// fromStage is null when the card is created onto the board.
model IssueEvent {
  id        String   @id @default(cuid())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId   String
  fromStage String? //                                   BoardStage
  toStage   String //                                    BoardStage
  // The developer's TeamMember row, resolved from the capability link they
  // used; or the QA member, once per-person sessions exist. Null = the shared
  // QA session, which is honest rather than attributing to nobody in particular.
  actor     TeamMember? @relation("EventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
  @@index([actorId, createdAt])
}

model IssueComment {
  id        String   @id @default(cuid())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId   String
  author    TeamMember? @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorId  String?
  body      String
  mentions  IssueMention[]
  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
}

// One row per person @mentioned in a comment — the structured reference the
// spec asks for, so dispatch never re-parses a body. notifiedAt doubles as the
// outbox: null means Slack did not confirm delivery, which is visible and
// retriable rather than swallowed.
model IssueMention {
  id         String       @id @default(cuid())
  comment    IssueComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId  String
  member     TeamMember   @relation("Mentioned", fields: [memberId], references: [id], onDelete: Cascade)
  memberId   String
  notifiedAt DateTime?
  createdAt  DateTime     @default(now())

  @@unique([commentId, memberId])
  @@index([memberId, notifiedAt])
}

// Screenshots on a card, stored as bytes like LayoutShot — the free tier has
// no object store to point image_urls at, and this keeps a card's evidence in
// the same database as the card.
model IssueImage {
  id          String   @id @default(cuid())
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId     String
  contentType String
  image       Bytes
  bytes       Int
  // The upload's own name, for the attachments list. Null on images from
  // before the column existed.
  filename    String?
  // At most one per card in practice — setCover clears the others in the same
  // transaction. Not a DB constraint: a partial unique index is not additive
  // DDL Prisma can express.
  isCover     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([issueId])
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String   @unique
  role        String   @default("DEVELOPER") // MemberRole — the work they do
  // Access, independent of role. See src/lib/permissions.ts. Defaults to MEMBER
  // so an existing person gains a login without gaining any admin power.
  rank         String    @default("MEMBER") // Rank
  email        String?   @unique // null until an admin gives them a login
  passwordHash String? // scrypt; null means "cannot sign in yet"
  lastLoginAt  DateTime?
  // Slack member id (U…), so a board @mention can ping them by name in the
  // channel the webhook posts to. Set from the team page; null = not pinged.
  slackUserId  String?
  active      Boolean  @default(true)
  devPages    Page[]   @relation("Dev")
  testerPages Page[]   @relation("Tester")
  // Boards. A developer keeps a TeamMember row for assignment and attribution
  // even with no login: their capability link resolves to it.
  assignedIssues  Issue[]        @relation("Assignee")
  reportedIssues  Issue[]        @relation("Reporter")
  issueEvents     IssueEvent[]   @relation("EventActor")
  issueComments   IssueComment[] @relation("CommentAuthor")
  mentionedIn     IssueMention[] @relation("Mentioned")
  createdAt   DateTime @default(now())
}

model QACertificate {
  id          String        @id @default(cuid())
  page        Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId      String        @unique
  status      String        @default("IN_PROGRESS") // CertStatus
  testerName  String?
  completedAt DateTime?
  items       QACheckItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model QACheckItem {
  id            String        @id @default(cuid())
  certificate   QACertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  certificateId String
  category      String //        Performance | Functional | Tracking | UX | Conversion Goals
  name          String
  result        String        @default("NA") // CheckResult
  valueDesktop  String?
  valueMobile   String?
  hasDualValue  Boolean       @default(false) // Desktop + Mobile inputs (browser tests, PageSpeed)
  isMeasurement Boolean       @default(false) // free-text value (load time, page size)
  notes         String?
  order         Int           @default(0)
  // Phase 3 (machine pre-fill + provenance). machine* are set only by the
  // human-confirm action (NEVER by background code — T4). confirmedSource records
  // whether a value was a human call or a confirmed machine result.
  machineVerdict  String? //   holding | failing | couldnt_verify (from qa_prefills)
  machineDetail   String?
  machineCheckedAt DateTime?
  confirmedSource String? //   'machine' | 'human'
  confirmedBy     String?
  confirmedAt     DateTime?

  @@index([certificateId])
}

// Reusable QA checklist templates. New certificates seed their items from the
// matching template (by platform) or the default; falls back to the built-in
// QA_TEMPLATE when none exist.
model ChecklistTemplate {
  id        String                  @id @default(cuid())
  name      String
  platform  String? //                 null = applies to any platform
  isDefault Boolean                 @default(false)
  items     ChecklistTemplateItem[]
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
}

model ChecklistTemplateItem {
  id            String            @id @default(cuid())
  template      ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId    String
  category      String
  name          String
  hasDualValue  Boolean           @default(false)
  isMeasurement Boolean           @default(false)
  order         Int               @default(0)
  // Flywheel (Phase 5): provenance for items born from a production incident.
  // Nullable; unset = a normal template item. Set only by the promote action.
  origin        String? //   'flywheel' when added from a production incident
  originAt      DateTime?

  @@index([templateId])
}

// Flywheel (Phase 5): production incidents that had no delivery check arrive here
// as candidates for human review. Own table; the human PROMOTE action is the ONLY
// writer of ChecklistTemplateItem (T4). Additive.
model ChecklistCandidate {
  id                  String    @id @default(cuid())
  linkspyCandidateRef String    @unique //   idempotency key for the inbox
  incidentClass       String
  proposedWording     String
  evidence            Json
  machineVerifiable   Boolean   @default(false)
  status              String    @default("draft") // draft | promoted | dismissed
  rationale           String? //   mandatory at promote-time (server-enforced)
  reason              String? //   optional dismiss reason
  decidedBy           String?
  decidedAt           DateTime?
  createdAt           DateTime  @default(now())

  @@index([status])
}

// Spine outbox (Phase 2 Seam 2): events written in the SAME transaction as the
// status change that produced them, drained to LinkSpy. Additive; emission is
// gated by SPINE_EMIT (unset = today's behaviour, no rows).
model SpineOutbox {
  id                    String    @id @default(cuid())
  type                  String
  payload               Json
  registryDeliverableId String?
  registrySiteId        String?
  occurredAt            DateTime  @default(now())
  deliveredAt           DateTime?
  attempts              Int       @default(0)
  lastError             String?
  createdAt             DateTime  @default(now())

  @@index([deliveredAt])
}

// Layout checking: a page someone wants watched, and the history of what the
// responsive sweep found each time it ran. Separate from Page/Project because a
// checked URL is not always a tracked deliverable — a competitor page, a
// client's page before it is onboarded, a preview link.
model LayoutSite {
  id             String             @id @default(cuid())
  url            String             @unique
  label          String? //          what a human calls it; falls back to the URL
  runs           LayoutRun[]
  devicePreviews DevicePreviewRun[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

// One sweep. `findings` is the engine's output verbatim, so a later change to
// how findings are shaped cannot rewrite history — the run records what the
// tool actually said at the time.
model LayoutRun {
  id        String     @id @default(cuid())
  site      LayoutSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId    String
  checkedAt DateTime   @default(now())
  findings  Json
  worst     String     @default("PASS") // FAIL | WARN | SKIP | PASS — for the list
  failCount Int        @default(0)
  warnCount Int        @default(0)
  shots     LayoutShot[]

  @@index([siteId, checkedAt])
}

// The rendered page at one width. Kept for the two most recent runs of a site
// only — that is what a before/after comparison needs, and it caps the images
// at roughly 64MB across ten sites instead of growing indefinitely. Findings
// history outlives the images; an older run still says what it found.
model LayoutShot {
  id     String    @id @default(cuid())
  run    LayoutRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId  String
  width  Int
  image  Bytes //     JPEG, viewport width by full page height
  bytes  Int //       recorded so storage can be reported without reading blobs

  @@unique([runId, width])
  @@index([runId])
}

// A cross-device preview run: the devicepreview service's report for one page,
// with a JPEG of each device's fold kept here for the two most recent runs.
// Full-page images and the diffable gallery stay on the service while it
// retains the run (serviceRunId); the verdicts survive here regardless.
model DevicePreviewRun {
  id             String              @id @default(cuid())
  site           LayoutSite          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId         String
  checkedAt      DateTime            @default(now())
  serviceRunId   String              @unique //   the run directory on the devicepreview service
  baselineRunId  String? //                        our run this one was diffed against
  report         Json //                           report.json as the service wrote it (schemaVersion 1)
  worst          String              @default("PASS") // FAIL | REGRESSED | BLOCKED | WARN | PASS — for lists
  deviceCount    Int                 @default(0)
  errorCount     Int                 @default(0)
  warnCount      Int                 @default(0)
  regressedCount Int                 @default(0)
  shots          DevicePreviewShot[]

  @@index([siteId, checkedAt])
}

model DevicePreviewShot {
  id        String           @id @default(cuid())
  run       DevicePreviewRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId     String
  profileId String
  image     Bytes //           JPEG of the fold, at most 900px wide
  bytes     Int //             recorded so storage can be reported without reading blobs

  @@unique([runId, profileId])
  @@index([runId])
}
